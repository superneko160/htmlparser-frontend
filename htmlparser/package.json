{
    "name": "htmlparser",
    "private": true,
    "version": "1.1.2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "bun install && tsc && vite build",
        "lint": "bunx @biomejs/biome lint ./src",
        "format": "bunx @biomejs/biome format --write .",
        "test": "vitest",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "motion": "^14.9.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "autoprefixer": "^10.6.1",
        "postcss": "^8.5.31",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
