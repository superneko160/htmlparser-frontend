{
    "name": "htmlparser",
    "private": true,
    "version": "1.1.2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "bun install && tsc && vite build",
        "lint": "bunx @biomejs/biome lint ./src",
        "format": "bunx @biomejs/biome format --write .",
        "test": "vitest",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "motion": "^12.43.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "autoprefixer": "^10.5.4",
        "postcss": "^8.5.26",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vitest": "^4.1.10"
    }
}
